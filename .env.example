LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b #LLM model used from GROQ

LLM_STUB=false #true -> skips model response and returns a hardcoded response object
LLM_KILL_SWITCH=false #true -> stops triage service

LLM_PROMPT_VERSION=v1 #version of system prompt used
LLM_TEMP=0.2 #LLM Temperature